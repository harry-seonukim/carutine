# 이 파일을 .env로 복사해서 쓴다. .env는 저장소에 올리지 않는다(.gitignore에 있음).

# development | test | production
NODE_ENV=development
PORT=3000

# DB 접속 정보 (비밀값: 운영 값은 배포 서비스의 환경 변수에만 넣는다)
#  - Docker 없이 로컬:   pglite://./.pgdata   (기본값, 폴더에 저장) 또는 pglite://memory
#  - docker compose DB:  postgres://carutine:carutine_local_only@localhost:5432/carutine
#  - 운영(Neon 등):      postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=pglite://./.pgdata

# 프록시(Render 등) 뒤에서 X-Forwarded-Proto를 믿고 HTTPS만 허용한다. production에서는 기본 true
TRUST_PROXY=false
REQUIRE_HTTPS=false

# 시작할 때 마이그레이션(기본 true) / 시드(기본 false) 자동 실행
AUTO_MIGRATE=true
AUTO_SEED=false

# 금지어 목록 파일
BANNED_WORDS_FILE=config/banned-words.json

# 요청 횟수 제한 (기기 기준, 기기 등록만 IP 기준)
RATE_READ_PER_MIN=120
RATE_UPLOAD_PER_DAY=10
RATE_REPORT_PER_DAY=20
RATE_REGISTER_PER_HOUR=10
# 같은 기기가 같은 spec을 다시 올릴 수 없는 시간(초), 숨김 기준 신고 기기 수
DUPLICATE_WINDOW_SEC=60
HIDE_AFTER_REPORTS=3

# 테스트를 실제 Postgres로 돌릴 때만 (테스트마다 새 DB를 만든다)
# TEST_DATABASE_URL=postgres://carutine:carutine_local_only@localhost:5432/carutine
